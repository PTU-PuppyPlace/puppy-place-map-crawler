generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Target {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NaverMapData {
  id        Int                  @id @default(autoincrement())
  sid       String               @unique
  title     String
  address   String
  latitude  Float
  longitude Float
  phone     String?
  schedule  String?             @db.Text
  category  NaverMapCategoryType
  information String?           @db.Text
  etc       String?
  available Boolean
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

enum NaverMapCategoryType {
  CAFE
  SHOPPING
  LIFE_CULTURE
  DINING
  BAR
}
